<UserControl
    x:Class="Stopwatch.Controls.StopwatchDisplayControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:android="http://uno.ui/android"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ex="using:Stopwatch.Extensions.Xaml"
    xmlns:lapVM="using:Stopwatch.ViewModels"
    xmlns:local="using:Stopwatch.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:not_android="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:win="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    d:DesignHeight="300"
    d:DesignWidth="400"
    mc:Ignorable="d android">

    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Viewbox Grid.Row="0" Stretch="Uniform">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <!--<FontIcon Glyph="{x:Bind Stopwatch.Icon, Mode=OneWay}" />-->
                    <TextBox
                        Padding="4"
                        HorizontalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0,0,0,0"
                        FontSize="40"
                        Text="{x:Bind Stopwatch.Name, Mode=TwoWay}" />
                </StackPanel>
                <Grid
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <not_android:TextBlock win:FontFamily="Segoe UI">
                        <Run FontSize="120" Text="{x:Bind Stopwatch.CurrentTime, Mode=OneWay}" />
                        <Run FontSize="80" Text="." />
                        <Run FontSize="80" Text="{x:Bind Stopwatch.CurrentTimeMilliseconds, Mode=OneWay}" />
                    </not_android:TextBlock>
                    <!--  Workaround for https://github.com/unoplatform/uno/issues/17282  -->
                    <android:TextBlock FontSize="120">
                        <Run Text="{x:Bind Stopwatch.CurrentTimeFull, Mode=OneWay}" />
                    </android:TextBlock>
                </Grid>
                <StackPanel
                    Grid.Row="2"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="StartStopButton"
                        Command="{x:Bind Stopwatch.StartStopCommand, Mode=OneWay}"
                        Style="{StaticResource AccentControlButtonStyle}">
                        <FontIcon Glyph="{x:Bind Stopwatch.IsRunning, Mode=OneWay, Converter={StaticResource IsRunningToSymbolConverter}}" />
                    </Button>
                    <Button Command="{x:Bind Stopwatch.LapCommand, Mode=OneWay}" Style="{StaticResource ControlButtonStyle}">
                        <SymbolIcon Symbol="Flag" />
                    </Button>
                    <Button Command="{x:Bind Stopwatch.ResetCommand, Mode=OneWay}" Style="{StaticResource ControlButtonStyle}">
                        <SymbolIcon Symbol="Undo" />
                    </Button>
                </StackPanel>
            </Grid>
        </Viewbox>
        <Expander
            Grid.Row="2"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            HorizontalContentAlignment="Stretch"
            ExpandDirection="Up"
            Header="{ex:Localize Key=Laps}"
            IsExpanded="{x:Bind Stopwatch.IsLapsListExpanded, Mode=TwoWay}">
            <Grid
                Grid.Row="2"
                MaxWidth="600"
                HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid
                    Grid.Row="0"
                    Padding="8"
                    BorderBrush="{ThemeResource AccentAAFillColorDefaultBrush}"
                    BorderThickness="0,0,0,1"
                    ColumnSpacing="16">
                    <Grid.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </Grid.Resources>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.8*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{ex:Localize Key=Lap}" />
                    <TextBlock Grid.Column="1" Text="{ex:Localize Key=LapTime}" />
                    <TextBlock Grid.Column="2" Text="{ex:Localize Key=TotalTime}" />
                    <TextBlock Grid.Column="3" Text="{ex:Localize Key=Note}" />
                </Grid>
                <ListView
                    Grid.Row="1"
                    HorizontalAlignment="Stretch"
                    ItemsSource="{x:Bind Stopwatch.Laps, Mode=OneWay}"
                    SelectionMode="Single">
                    <ListView.ItemContainerStyle>
                        <!--  Apply BasedOn only on WinUI as the style is not available in Uno Platform https://github.com/unoplatform/uno/issues/17231  -->
                        <Style win:BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="lapVM:LapViewModel">
                            <Grid Background="Transparent" ColumnSpacing="16">
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem
                                            Command="{x:Bind RequestDeleteCommand}"
                                            Icon="Delete"
                                            Text="Delete" />
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                                <Grid.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                    <Style BasedOn="{StaticResource DefaultTextBoxStyle}" TargetType="TextBox">
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0,0,0,2" />
                                    </Style>
                                    <Style
                                        x:Key="LapHighlightTextBlockStyle"
                                        BasedOn="{StaticResource CaptionTextBlockStyle}"
                                        TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="TextWrapping" Value="NoWrap" />
                                    </Style>
                                    <Style BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </Grid.Resources>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.8*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontWeight="Bold"
                                        Text="{x:Bind Order}" />
                                    <TextBlock
                                        x:Name="FastestBlock"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        x:Load="True"
                                        Style="{ThemeResource LapHighlightTextBlockStyle}"
                                        Text="{ex:Localize Key=Fastest}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap"
                                        Visibility="{x:Bind IsFastest, Mode=OneWay}" />
                                    <TextBlock
                                        x:Name="SlowestBlock"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        x:Load="True"
                                        Style="{ThemeResource LapHighlightTextBlockStyle}"
                                        Text="{ex:Localize Key=Slowest}"
                                        Visibility="{x:Bind IsSlowest, Mode=OneWay}" />
                                </Grid>
                                <TextBlock Grid.Column="1" Text="{x:Bind TimeString}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind TotalTimeString}" />
                                <TextBox Grid.Column="3" Text="{x:Bind Note, Mode=TwoWay}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel
                    Grid.Row="2"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button Style="{ThemeResource SubtleButtonStyle}" ToolTipService.ToolTip="Export">
                        <FontIcon Glyph="&#xE72D;" />
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem 
                                    Command="{x:Bind MainViewModel.ExportToJsonCommand}"
                                    Icon="Page" 
                                    Text="Export to JSON" />
                                <MenuFlyoutItem 
                                    Command="{x:Bind MainViewModel.ExportToCsvCommand}"
                                    Icon="Document" 
                                    Text="Export to CSV" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </Expander>
    </Grid>
</UserControl>
