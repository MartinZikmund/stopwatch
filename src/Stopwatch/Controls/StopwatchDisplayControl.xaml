<UserControl
    x:Class="Stopwatch.Controls.StopwatchDisplayControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:android="http://uno.ui/android"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ex="using:Stopwatch.Extensions.Xaml"
    xmlns:local="using:Stopwatch.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:not_android="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:win="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    d:DesignHeight="300"
    d:DesignWidth="400"
    mc:Ignorable="d android">

    <Grid x:Name="RootGrid" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition x:Name="LapsRowDefinition" Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="LapsColumnDefinition" Width="0" />
        </Grid.ColumnDefinitions>

        <Viewbox
            x:Name="TimerViewbox"
            Grid.Row="0"
            Stretch="Uniform">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel
                    x:Name="StopwatchNamePanel"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <!--<FontIcon Glyph="{x:Bind Stopwatch.Icon, Mode=OneWay}" />-->
                    <TextBox
                        x:Name="StopwatchNameTextBox"
                        Padding="4"
                        HorizontalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0,0,0,0"
                        FontSize="40"
                        Text="{x:Bind Stopwatch.Name, Mode=TwoWay}" />
                </StackPanel>
                <Grid
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <not_android:TextBlock win:FontFamily="Segoe UI">
                        <Run FontSize="120" Text="{x:Bind Stopwatch.CurrentTime, Mode=OneWay}" />
                        <Run FontSize="80" Text="." />
                        <Run FontSize="80" Text="{x:Bind Stopwatch.CurrentTimeMilliseconds, Mode=OneWay}" />
                    </not_android:TextBlock>
                    <!--  Workaround for https://github.com/unoplatform/uno/issues/17282  -->
                    <android:TextBlock FontSize="120">
                        <Run Text="{x:Bind Stopwatch.CurrentTimeFull, Mode=OneWay}" />
                    </android:TextBlock>
                </Grid>
                <StackPanel
                    Grid.Row="2"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="ResetButton"
                        Command="{x:Bind Stopwatch.ResetCommand, Mode=OneWay}"
                        Style="{StaticResource ControlButtonStyle}">
                        <SymbolIcon Symbol="Undo" />
                    </Button>
                    <Button
                        x:Name="StartStopButton"
                        Command="{x:Bind Stopwatch.StartStopCommand, Mode=OneWay}"
                        Style="{StaticResource LargeAccentControlButtonStyle}">
                        <FontIcon
                            x:Name="StartStopButtonIcon"
                            FontSize="32"
                            Glyph="{x:Bind Stopwatch.IsRunning, Mode=OneWay, Converter={StaticResource IsRunningToSymbolConverter}}" />
                    </Button>
                    <Button
                        x:Name="LapButton"
                        Command="{x:Bind Stopwatch.LapCommand, Mode=OneWay}"
                        Style="{StaticResource ControlButtonStyle}">
                        <SymbolIcon Symbol="Flag" />
                    </Button>
                </StackPanel>
            </Grid>
        </Viewbox>
        <Expander
            x:Name="LapsExpander"
            Grid.Row="1"
            Padding="4"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            HorizontalContentAlignment="Stretch"
            ExpandDirection="Up"
            IsExpanded="{x:Bind Stopwatch.IsLapsListExpanded, Mode=TwoWay}">
            <Expander.Header>
                <Grid HorizontalAlignment="Stretch" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="{ex:Localize Key=Laps}" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind Stopwatch.Laps.Count, Mode=OneWay, Converter={StaticResource CountToVisibilityConverter}}">
                        <Run Text="{ex:Localize Key=Average}" /><Run Text=": " />
                        <Run Text="{x:Bind Stopwatch.Laps.AverageLapString, Mode=OneWay}" />
                    </TextBlock>
                </Grid>
            </Expander.Header>
            <Grid>
                <local:LapsListControl
                    MaxWidth="600"
                    Laps="{x:Bind Stopwatch.Laps, Mode=OneWay}" />
                <Button
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Style="{ThemeResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="Export">
                    <FontIcon Glyph="&#xE72D;" />
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem
                                Command="{x:Bind MainViewModel.ExportToCsvCommand}"
                                Icon="Document"
                                Text="{ex:Localize Key=ExportToCsv}" />
                            <MenuFlyoutItem
                                Command="{x:Bind MainViewModel.ExportToJsonCommand}"
                                Icon="Page"
                                Text="{ex:Localize Key=ExportToJson}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>
        </Expander>

        <!--  Landscape laps flyout button: shown in compact landscape instead of inline expander  -->
        <Button
            x:Name="LapsFlyoutButton"
            Grid.Row="1"
            Padding="16,12"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            HorizontalContentAlignment="Stretch"
            Visibility="Collapsed">
            <Grid HorizontalAlignment="Stretch" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="{ex:Localize Key=Laps}" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Visibility="{x:Bind Stopwatch.Laps.Count, Mode=OneWay, Converter={StaticResource CountToVisibilityConverter}}">
                    <Run Text="{ex:Localize Key=Average}" /><Run Text=": " />
                    <Run Text="{x:Bind Stopwatch.Laps.AverageLapString, Mode=OneWay}" />
                </TextBlock>
                <FontIcon
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Glyph="&#xE70E;" />
            </Grid>
            <Button.Flyout>
                <Flyout x:Name="LapsFlyout" Placement="TopEdgeAlignedRight">
                    <Grid
                        MinWidth="400"
                        MaxWidth="600"
                        MaxHeight="300">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <local:LapsListControl Laps="{x:Bind Stopwatch.Laps, Mode=OneWay}" />
                        <StackPanel
                            Grid.Row="1"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button Style="{ThemeResource SubtleButtonStyle}" ToolTipService.ToolTip="Export">
                                <FontIcon Glyph="&#xE72D;" />
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem
                                            Command="{x:Bind MainViewModel.ExportToCsvCommand}"
                                            Icon="Document"
                                            Text="{ex:Localize Key=ExportToCsv}" />
                                        <MenuFlyoutItem
                                            Command="{x:Bind MainViewModel.ExportToJsonCommand}"
                                            Icon="Page"
                                            Text="{ex:Localize Key=ExportToJson}" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Flyout>
            </Button.Flyout>
        </Button>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="CompactOverlayStates">
                <VisualState x:Name="NormalMode" />
                <VisualState x:Name="CompactOverlayMode">
                    <VisualState.Setters>
                        <Setter Target="StopwatchNamePanel.Visibility" Value="Collapsed" />
                        <Setter Target="LapsExpander.Visibility" Value="Collapsed" />
                        <Setter Target="LapsRowDefinition.Height" Value="Auto" />
                        <Setter Target="ResetButton.Style" Value="{StaticResource CompactControlButtonStyle}" />
                        <Setter Target="StartStopButton.Style" Value="{StaticResource CompactAccentControlButtonStyle}" />
                        <Setter Target="StartStopButtonIcon.FontSize" Value="24" />
                        <Setter Target="LapButton.Style" Value="{StaticResource CompactControlButtonStyle}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</UserControl>
