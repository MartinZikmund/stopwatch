<Project Sdk="Uno.Sdk">
	<PropertyGroup>
		<TargetFrameworks>
			net10.0-windows10.0.26100;
			net10.0-android;
			net10.0-ios;
			net10.0-desktop;
			net10.0-browserwasm;
		</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<UnoSingleProject>true</UnoSingleProject>

		<!-- Display name -->
		<ApplicationTitle>Fluent Stopwatch</ApplicationTitle>
		<!-- App Identifier -->
		<ApplicationId>dev.mzikmund.stopwatch</ApplicationId>
		<!-- Versions -->
		<ApplicationDisplayVersion>0.9.3</ApplicationDisplayVersion>
		<ApplicationVersion>22</ApplicationVersion>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>

		<UnoFeatures>
			Hosting;
			Mvvm;
			Localization;
			ThemeService;
			SkiaRenderer;
			Skia;
		</UnoFeatures>

		<UnoIconBackgroundFile>Assets/Icons/icon_transparent.svg</UnoIconBackgroundFile>
		<UnoIconBackgroundFile Condition="'$(IsIOS)' == 'true' or '$(IsAndroid)' == 'true'">Assets/Icons/icon.svg</UnoIconBackgroundFile>

		<UnoIconForegroundScale>1</UnoIconForegroundScale>
		<UnoIconForegroundScale Condition="'$(IsAndroid)' == 'true'">0.65</UnoIconForegroundScale>

	</PropertyGroup>

	<PropertyGroup Condition="'$(TargetFramework)'=='net10.0-browserwasm'">
		<WasmShellEnableIDBFS>true</WasmShellEnableIDBFS>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
		<PackageReference Include="CommunityToolkit.WinUI.Converters" />
		<PackageReference Include="CommunityToolkit.WinUI.Helpers" />
		<PackageReference Include="LiteDB" Condition="'!$(IsIOS)' and !'$(IsAndroid)'" />
		<PackageReference Include="MZikmund.Toolkit.WinUI" />
		<PackageReference Include="Plugin.InAppBilling" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="../Stopwatch.SourceGenerators/Stopwatch.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>

	<ItemGroup>
		<AdditionalFiles Include="../Directory.Packages.props" />
	</ItemGroup>
</Project>
