<local:SettingsViewBase
    x:Class="Stopwatch.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ex="using:Stopwatch.Extensions.Xaml"
    xmlns:local="using:Stopwatch.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    mc:Ignorable="d">

    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Command="{x:Bind ViewModel.GoBackCommand}" Style="{ThemeResource NavigationBackButtonStyle}" />
            <TextBlock
                Grid.Column="1"
                Style="{ThemeResource TitleTextBlockStyle}"
                Text="{ex:Localize Key=Settings}" />
        </Grid>
        <ScrollViewer Grid.Row="1">
			<StackPanel Orientation="Vertical">
				<toolkit:SettingsCard
                    Header="{ex:Localize Key=FullScreen}"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE708;}">
					<ComboBox ItemsSource="{x:Bind ViewModel.ThemeOptions}" Style="{StaticResource DefaultComboBoxStyle}" SelectedItem="{x:Bind ViewModel.SelectedTheme, Mode=TwoWay}">
						<ComboBox.ItemTemplate>
							<DataTemplate x:DataType="ElementTheme">
								<TextBlock Text="{x:Bind Converter={StaticResource EnumLocalizationConverter}}" />
							</DataTemplate>
						</ComboBox.ItemTemplate>
					</ComboBox>
				</toolkit:SettingsCard>
				<toolkit:SettingsCard
                    Header="{ex:Localize Key=BackgroundColor}"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE708;}">
					<SplitButton>
						<Border x:Name="CurrentColor" Width="32" Height="32" CornerRadius="4,0,0,4">
							<Border.Background>
								<SolidColorBrush Color="{x:Bind ViewModel.BackgroundColor, Mode=OneWay}" />
							</Border.Background>
						</Border>
						<SplitButton.Flyout>
							<Flyout Placement="Bottom">
								<ColorPicker IsAlphaSliderVisible="True" IsAlphaEnabled="True" Color="{x:Bind ViewModel.BackgroundColor, Mode=TwoWay}" />
							</Flyout>
						</SplitButton.Flyout>
					</SplitButton>
				</toolkit:SettingsCard>
				<!--<toolkit:SettingsCard
                    Header="{ex:Localize Key=BackgroundColor}"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE708;}">
					<StackPanel Orientation="Horizontal">
						<Button Content="{ex:Localize Key=BrowseImage}" Command="{x:Bind ViewModel.BrowseImageCommand}" />
						<Button Visibility="{x:Bind ViewModel.BackroundImage, Mode=OneWay, Converter={StaticResource }}" Content="{ex:Localize Key=BrowseImage}" Command="{x:Bind ViewModel.ClaerImageCommand}" />
					</StackPanel>
				</toolkit:SettingsCard>-->

			</StackPanel>
		</ScrollViewer>
    </Grid>
</local:SettingsViewBase>
