<UserControl
    x:Class="Stopwatch.Controls.StopwatchDisplayControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:android="http://uno.ui/android"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ex="using:Stopwatch.Extensions.Xaml"
    xmlns:local="using:Stopwatch.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:not_android="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:lapVM="using:Stopwatch.ViewModels"
    d:DesignHeight="300"
    d:DesignWidth="400"
    mc:Ignorable="d android">

	<Grid RowSpacing="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="*" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<Viewbox Grid.Row="0" Stretch="Uniform">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>
				<StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
					<!--<FontIcon Glyph="{x:Bind Stopwatch.Icon, Mode=OneWay}" />-->
					<TextBox Padding="4" FontSize="40" Text="{x:Bind Stopwatch.Name, Mode=TwoWay}" Background="Transparent" HorizontalAlignment="Center" BorderThickness="0,0,0,0" />
				</StackPanel>
				<Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
					<not_android:TextBlock FontFamily="Segoe UI">
						<Run FontSize="120" Text="{x:Bind Stopwatch.CurrentTime, Mode=OneWay}" />
						<Run FontSize="80" Text="{x:Bind Stopwatch.CurrentTimeMilliseconds, Mode=OneWay}" />
					</not_android:TextBlock>
					<!--  Workaround for https://github.com/unoplatform/uno/issues/17282  -->
					<android:TextBlock FontSize="120">
						<Run Text="{x:Bind Stopwatch.CurrentTimeFull, Mode=OneWay}" />
					</android:TextBlock>
				</Grid>
				<StackPanel
                    Grid.Row="2"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
					<Button
                        x:Name="StartStopButton"
                        Command="{x:Bind Stopwatch.StartStopCommand, Mode=OneWay}"
                        Style="{StaticResource AccentControlButtonStyle}">
						<FontIcon Glyph="{x:Bind Stopwatch.IsRunning, Mode=OneWay, Converter={StaticResource IsRunningToSymbolConverter}}" />
					</Button>
					<Button Command="{x:Bind Stopwatch.LapCommand, Mode=OneWay}" Style="{StaticResource ControlButtonStyle}">
						<SymbolIcon Symbol="Flag" />
					</Button>
					<Button Command="{x:Bind Stopwatch.ResetCommand, Mode=OneWay}" Style="{StaticResource ControlButtonStyle}">
						<SymbolIcon Symbol="Undo" />
					</Button>
				</StackPanel>
			</Grid>
		</Viewbox>
		<Grid
            Grid.Row="2"
            MaxWidth="600"
            HorizontalAlignment="Stretch">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>
			<Grid
                Padding="8"
                BorderBrush="{ThemeResource AccentAAFillColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                ColumnSpacing="16">
				<Grid.Resources>
					<Style TargetType="TextBlock">
						<Setter Property="FontWeight" Value="SemiBold" />
					</Style>
				</Grid.Resources>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>
				<TextBlock Text="{ex:Localize Key=Laps}" />
				<TextBlock Grid.Column="1" Text="{ex:Localize Key=LapTime}" />
				<TextBlock Grid.Column="2" Text="{ex:Localize Key=TotalTime}" />
				<TextBlock Grid.Column="3" Text="{ex:Localize Key=Note}" />
			</Grid>
			<ListView
                Grid.Row="1"
                HorizontalAlignment="Stretch"
                ItemsSource="{x:Bind Stopwatch.Laps, Mode=OneWay}">
				<ListView.ItemContainerStyle>
					<Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
						<Setter Property="HorizontalAlignment" Value="Stretch" />
						<Setter Property="HorizontalContentAlignment" Value="Stretch" />
					</Style>
				</ListView.ItemContainerStyle>
				<ListView.ItemTemplate>
					<DataTemplate x:DataType="lapVM:LapViewModel">
						<Grid ColumnSpacing="16">
							<Grid.Resources>
								<Style TargetType="TextBlock">
									<Setter Property="VerticalAlignment" Value="Center" />
								</Style>
								<Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
									<Setter Property="VerticalAlignment" Value="Center" />
									<Setter Property="Background" Value="Transparent" />
									<Setter Property="BorderThickness" Value="0,0,0,2" />
								</Style>
							</Grid.Resources>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<StackPanel Orientation="Horizontal" Spacing="16">
								<TextBlock FontWeight="Bold" Text="{x:Bind Order}" />
								<TextBlock
                                    x:Name="FastestBlock"
                                    Grid.Column="2"
                                    x:Load="True"
									VerticalAlignment="Center"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{ex:Localize Key=Fastest}"
                                    Visibility="{x:Bind IsFastest, Mode=OneWay}" />
								<TextBlock
                                    x:Name="SlowestBlock"
                                    Grid.Column="2"
                                    x:Load="True"
									VerticalAlignment="Center"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{ex:Localize Key=Slowest}"
                                    Visibility="{x:Bind IsSlowest, Mode=OneWay}" />
							</StackPanel>
							<TextBlock Grid.Column="1" Text="{x:Bind TimeString}" />
							<TextBlock Grid.Column="2" Text="{x:Bind TotalTimeString}" />
							<TextBox Background="Transparent" Grid.Column="3" Text="{x:Bind Note, Mode=TwoWay}" />
						</Grid>
					</DataTemplate>
				</ListView.ItemTemplate>
			</ListView>
		</Grid>
	</Grid>
</UserControl>
