<local:MainViewBase
    x:Class="Stopwatch.Views.MainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Stopwatch.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ex="using:Stopwatch.Extensions.Xaml"
    xmlns:local="using:Stopwatch.Views"
	xmlns:vm="using:Stopwatch.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wctc="using:CommunityToolkit.WinUI.Converters">

	<Grid>

		<!--  Background color  -->
		<Border>
			<Border.Background>
				<SolidColorBrush Color="{x:Bind ViewModel.SelectedStopwatch.BackgroundColor, Mode=OneWay}" />
			</Border.Background>
		</Border>

		<!--  Background image  -->
		<Border Visibility="{x:Bind ViewModel.SelectedStopwatch.BackgroundImageUri, Converter={StaticResource NonNullToVisibilityConverter}, FallbackValue=Collapsed, Mode=OneWay}">
			<Image
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Opacity="{x:Bind ViewModel.SelectedStopwatch.BackgroundImageOpacity, Mode=OneWay}"
                Stretch="UniformToFill">
				<Image.Source>
					<BitmapImage UriSource="{x:Bind ViewModel.SelectedStopwatch.BackgroundImageUri, Mode=OneWay}" />
				</Image.Source>
			</Image>
		</Border>

		<Grid
            Padding="36,0,36,36"
            Background="Transparent"
            PointerMoved="RootGridPointerEvent"
            PointerPressed="RootGridPointerEvent"
            RowSpacing="20">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>

			<TabView x:Name="StopwatchTabView" TabItemsSource="{x:Bind ViewModel.Stopwatches}" TabCloseRequested="TabView_TabCloseRequested" AddTabButtonCommand="{x:Bind ViewModel.AddStopwatchCommand}" SelectedItem="{x:Bind ViewModel.SelectedStopwatch, Mode=TwoWay}">
				<TabView.TabItemTemplate>
					<DataTemplate x:DataType="vm:StopwatchViewModel">
						<TabViewItem Header="{x:Bind Name, Mode=OneWay}" IsClosable="True" />
					</DataTemplate>
				</TabView.TabItemTemplate>
			</TabView>

			<Border Background="Transparent" VerticalAlignment="Stretch" x:Name="DraggableArea" />

			<StackPanel
				Grid.Row="1"
                x:Name="ControlButtonsPanel"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
				Margin="0,8,0,0"
                Spacing="8">
				<Button
                    Command="{x:Bind ViewModel.ToggleFullScreenCommand}"
                    Style="{ThemeResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="{ex:Localize Key=FullScreen}"
                    Visibility="{x:Bind ViewModel.ShowFullScreenButton, Mode=OneWay}">
					<FontIcon Glyph="{x:Bind ViewModel.IsFullScreen, Mode=OneWay, Converter={StaticResource IsFullScreenToSymbolConverter}}" />
				</Button>
				<!--<Button
                    Command="{x:Bind ViewModel.ToggleCompactOverlayCommand}"
                    Style="{ThemeResource SubtleButtonStyle}"
                    Visibility="{x:Bind ViewModel.ShowCompactOverlayButton, Mode=OneWay}">
					<Grid>
						<FontIcon Glyph="{x:Bind ViewModel.IsCompactOverlay, Mode=OneWay, Converter={StaticResource IsCompactOverlayToSymbolConverter}}" />
					</Grid>
				</Button>-->
				<Button Command="{x:Bind ViewModel.GoToHistoryCommand}" Style="{ThemeResource SubtleButtonStyle}">
					<FontIcon Glyph="&#xE81C;" />
				</Button>
				<Button Visibility="{x:Bind ViewModel.HasProLicense, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}" Command="{x:Bind ViewModel.GoToGetProCommand}" Style="{ThemeResource SubtleButtonStyle}">
					<FontIcon Glyph="&#xF133;" />
				</Button>
				<Button Command="{x:Bind ViewModel.GoToSettingsCommand}" Style="{ThemeResource SubtleButtonStyle}">
					<SymbolIcon Symbol="Setting" />
				</Button>
			</StackPanel>

			<controls:StopwatchDisplayControl Grid.Row="2" Stopwatch="{x:Bind ViewModel.SelectedStopwatch, Mode=OneWay}" />
		</Grid>
	</Grid>
</local:MainViewBase>
