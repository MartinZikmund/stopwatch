<local:SettingsViewBase
    x:Class="Stopwatch.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ex="using:Stopwatch.Extensions.Xaml"
    xmlns:local="using:Stopwatch.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    mc:Ignorable="d">

    <local:SettingsViewBase.Resources>
        <Style
            x:Key="SettingsSectionHeaderTextBlockStyle"
            BasedOn="{StaticResource BodyStrongTextBlockStyle}"
            TargetType="TextBlock">
            <Style.Setters>
                <Setter Property="Margin" Value="1,30,0,6" />
            </Style.Setters>
        </Style>
        <x:Double x:Key="SettingsControlMinWidth">100</x:Double>
    </local:SettingsViewBase.Resources>

    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid
            x:Name="HeaderPanel"
            Margin="12,48,12,8"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Command="{x:Bind ViewModel.GoBackCommand}" Style="{ThemeResource NavigationBackButtonStyle}" />
            <TextBlock
                Grid.Column="1"
                Style="{ThemeResource TitleTextBlockStyle}"
                Text="{ex:Localize Key=Settings}" />
        </Grid>
        <ScrollViewer Grid.Row="1">
            <Border>
                <!--  Workaround for https://github.com/unoplatform/uno/issues/7000  -->
                <StackPanel
                    x:Name="ContentRoot"
                    Margin="12,0,12,12"
                    Orientation="Vertical"
                    Spacing="8">
                    <!--  General  -->
                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="{ex:Localize Key=General}" />

                    <toolkit:SettingsCard Header="Test data" Visibility="{x:Bind ViewModel.IsDebug}">
                        <Button Command="{Binding AddTestDataCommand}" Content="Add test data" />
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard
                        Description="{ex:Localize Key=KeepScreenOnSettingDescription}"
                        Header="{ex:Localize Key=KeepScreenOn}"
                        HeaderIcon="{ex:FontIcon Glyph=&#xF182;}">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.KeepScreenOn, Mode=TwoWay}" />
                    </toolkit:SettingsCard>

                    <!--  Customization  -->
                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="{ex:Localize Key=Customization}" />

                    <toolkit:SettingsCard Header="{ex:Localize Key=Theme}" HeaderIcon="{ex:FontIcon Glyph=&#xE793;}">
                        <ComboBox
                            MinWidth="{StaticResource SettingsControlMinWidth}"
                            IsTextSearchEnabled="True"
                            ItemsSource="{x:Bind ViewModel.ThemeOptions}"
                            SelectedItem="{x:Bind ViewModel.Theme, Mode=TwoWay}"
                            Style="{StaticResource DefaultComboBoxStyle}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="ElementTheme">
                                    <TextBlock Text="{x:Bind Converter={StaticResource EnumLocalizationConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard
                        Description="{ex:Localize Key=BackgroundColorSettingDescription}"
                        Header="{ex:Localize Key=BackgroundColor}"
                        HeaderIcon="{ex:FontIcon Glyph=&#xE790;}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                MinWidth="{StaticResource SettingsControlMinWidth}"
                                Command="{x:Bind ViewModel.PickBackgroundColorCommand}"
                                Content="{ex:Localize Key=Pick}" />
                            <Button
                                VerticalAlignment="Stretch"
                                Command="{x:Bind ViewModel.RemoveBackgroundColorCommand}"
                                ToolTipService.ToolTip="{ex:Localize Key=Clear}"
                                Visibility="{x:Bind ViewModel.IsBackgroundColorSet, Mode=OneWay}">
                                <FontIcon FontSize="{ThemeResource InfoBarIconFontSize}" Glyph="&#xE7A7;" />
                            </Button>
                        </StackPanel>
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Header="{ex:Localize Key=BackgroundImage}" HeaderIcon="{ex:FontIcon Glyph=&#xE91B;}">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <FontIcon
                                Foreground="Gold"
                                Glyph="&#xF133;"
                                Visibility="{x:Bind ViewModel.HasProLicense, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}" />

                            <Button
                                MinWidth="{StaticResource SettingsControlMinWidth}"
                                Command="{x:Bind ViewModel.PickBackgroundImageCommand}"
                                Content="{ex:Localize Key=Browse}" />
                            <Button
                                VerticalAlignment="Stretch"
                                Command="{x:Bind ViewModel.RemoveBackgroundImageCommand}"
                                ToolTipService.ToolTip="{ex:Localize Key=Clear}"
                                Visibility="{x:Bind ViewModel.IsBackgroundImageSet, Mode=OneWay}">
                                <FontIcon FontSize="{ThemeResource InfoBarIconFontSize}" Glyph="&#xE7A7;" />
                            </Button>
                        </StackPanel>
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard
                        Header="{ex:Localize Key=BackgroundImageOpacity}"
                        HeaderIcon="{ex:FontIcon Glyph=&#xE7B3;}"
                        IsEnabled="{x:Bind ViewModel.IsBackgroundImageSet, Mode=OneWay}">
                        <StackPanel>
                            <Slider
                                Width="{StaticResource SettingsControlMinWidth}"
                                Maximum="100"
                                Minimum="0"
                                Value="{x:Bind ViewModel.BackgroundImageOpacityPercent, Mode=TwoWay}" />
                        </StackPanel>
                    </toolkit:SettingsCard>

                    <Grid
                        Width="320"
                        Height="240"
                        HorizontalAlignment="Center"
                        BorderBrush="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderThickness="4"
                        CornerRadius="8">
                        <Grid.Background>
                            <SolidColorBrush Color="{x:Bind ViewModel.BackgroundColor, Mode=OneWay}" />
                        </Grid.Background>
                        <Image
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Opacity="{x:Bind ViewModel.BackgroundImageOpacity, Mode=OneWay}"
                            Stretch="UniformToFill">
                            <Image.Source>
                                <BitmapImage UriSource="{x:Bind ViewModel.BackgroundImageUri, Mode=OneWay}" />
                            </Image.Source>
                        </Image>

                        <Viewbox Margin="20">
                            <TextBlock>
                                <Run FontSize="120" Text="01:23:45." />
                                <Run FontSize="80" Text="67" />
                            </TextBlock>
                        </Viewbox>

                        <TextBlock
                            Margin="4"
                            VerticalAlignment="Bottom"
                            Opacity="0.5"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{ex:Localize Key=Preview}" />
                    </Grid>

                    <!--  About  -->
                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="{ex:Localize Key=About}" />

                    <toolkit:SettingsCard
                        Description="{ex:Localize Key=NoPurchasesToRestore}"
                        Header="{ex:Localize Key=RestorePurchases}"
                        HeaderIcon="{ex:FontIcon Glyph=&#xE777;}"
                        Visibility="{x:Bind ViewModel.HasProLicense, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}">
                        <Button
                            MinWidth="{StaticResource SettingsControlMinWidth}"
                            Command="{x:Bind ViewModel.RestorePurchasesCommand}"
                            Content="{ex:Localize Key=RestorePurchases}" />
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard Description="{ex:Localize Key=AboutAppDescription}" Header="{ex:Localize Key=ApplicationName}">
                        <toolkit:SettingsCard.HeaderIcon>
                            <BitmapIcon ShowAsMonochrome="False" UriSource="ms-appx:///Assets/Icons/icon_foreground.png" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <TextBlock Text="{x:Bind ViewModel.PackageVersionString, Mode=OneWay}" />
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard
                        Description="{ex:Localize Key=ReviewAppDescription}"
                        Header="{ex:Localize Key=ReviewApp}"
                        HeaderIcon="{ex:FontIcon Glyph=&#xE90A;}">
                        <Button
                            MinWidth="{StaticResource SettingsControlMinWidth}"
                            Command="{x:Bind ViewModel.ReviewAppCommand}"
                            Content="{ex:Localize Key=ReviewAction}" />
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard
                        Description="{ex:Localize Key=ShowOnboardingTipsDescription}"
                        Header="{ex:Localize Key=ShowOnboardingTips}"
                        HeaderIcon="{ex:FontIcon Glyph=&#xE9A9;}">
                        <Button
                            MinWidth="{StaticResource SettingsControlMinWidth}"
                            Command="{x:Bind ViewModel.ShowOnboardingTipsCommand}"
                            Content="{ex:Localize Key=View}" />
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard
                        Description="{ex:Localize Key=ThirdPartySoftwareDescription}"
                        Header="{ex:Localize Key=ThirdPartySoftware}"
                        HeaderIcon="{ex:FontIcon Glyph=&#xE8F1;}">
                        <Button
                            MinWidth="{StaticResource SettingsControlMinWidth}"
                            Command="{x:Bind ViewModel.ShowThirdPartySoftwareCommand}"
                            Content="{ex:Localize Key=View}" />
                    </toolkit:SettingsCard>
                </StackPanel>
            </Border>
        </ScrollViewer>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Narrow" />
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="640" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeaderPanel.Margin" Value="24,60,24,24" />
                        <Setter Target="ContentRoot.Margin" Value="24,0,24,24" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</local:SettingsViewBase>
