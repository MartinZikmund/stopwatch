<local:HistoryDetailViewBase
    x:Class="Stopwatch.Views.HistoryDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ex="using:Stopwatch.Extensions.Xaml"
    xmlns:local="using:Stopwatch.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Stopwatch.Models"
    mc:Ignorable="d">

    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!--  Header  -->
            <RowDefinition Height="*" />
            <!--  Content  -->
        </Grid.RowDefinitions>

        <!--  Header: Back + Title  -->
        <Grid Margin="36,60,36,36" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Command="{x:Bind ViewModel.GoBackCommand}" Style="{ThemeResource NavigationBackButtonStyle}" />
            <TextBlock
                Grid.Column="1"
                Style="{ThemeResource TitleTextBlockStyle}"
                Text="{x:Bind ViewModel.HistoryEntry.Name, Mode=OneWay}" />
        </Grid>

        <!--  Content: Read-only display + Actions  -->
        <ScrollViewer Grid.Row="1">
            <StackPanel
                MaxWidth="800"
                Margin="36,0,36,36"
                Spacing="24">

                <!--  Stopwatch Display (read-only)  -->
                <StackPanel Spacing="16">
                    <!--  Icon + Name  -->
                    <StackPanel HorizontalAlignment="Center" Spacing="12">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="48"
                            Text="{x:Bind ViewModel.HistoryEntry.Icon, Mode=OneWay}" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{ThemeResource TitleTextBlockStyle}"
                            Text="{x:Bind ViewModel.HistoryEntry.Name, Mode=OneWay}" />
                    </StackPanel>

                    <!--  Large time display  -->
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="48"
                        FontWeight="SemiBold"
                        Text="{x:Bind ViewModel.HistoryEntry.PausedElapsedTime, Mode=OneWay}" />

                    <!--  Date/time info  -->
                    <StackPanel HorizontalAlignment="Center" Spacing="8">
                        <TextBlock HorizontalAlignment="Center" Opacity="0.7">
                            <Run Text="{ex:Localize Key=Started}" />
                            <Run Text=": " />
                            <Run Text="{x:Bind ViewModel.HistoryEntry.InitialStartTime, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock HorizontalAlignment="Center" Opacity="0.7">
                            <Run Text="{ex:Localize Key=Laps}" />
                            <Run Text=": " />
                            <Run Text="{x:Bind ViewModel.HistoryEntry.LapCount, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <!--  Laps Section  -->
                <StackPanel Spacing="8">
                    <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="{ex:Localize Key=Laps}" />

                    <!--  Laps Header  -->
                    <Grid Padding="8,4" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <!--  Lap Time  -->
                            <ColumnDefinition Width="*" />
                            <!--  Total Time  -->
                            <ColumnDefinition Width="2*" />
                            <!--  Note  -->
                        </Grid.ColumnDefinitions>
                        <TextBlock Opacity="0.7" Text="{ex:Localize Key=LapTime}" />
                        <TextBlock
                            Grid.Column="1"
                            Opacity="0.7"
                            Text="{ex:Localize Key=TotalTime}" />
                        <TextBlock
                            Grid.Column="2"
                            Opacity="0.7"
                            Text="{ex:Localize Key=Note}" />
                    </Grid>

                    <!--  Laps List  -->
                    <ListView ItemsSource="{x:Bind ViewModel.HistoryEntry.Laps, Mode=OneWay}" SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:LapModel">
                                <Grid Padding="8,4" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="2*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind TotalTime}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind TotalTime}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Text="{x:Bind Note}"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <!--  Actions  -->
                <StackPanel Spacing="8">
                    <Button
                        HorizontalAlignment="Stretch"
                        Command="{x:Bind ViewModel.RestoreCommand}"
                        Style="{ThemeResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE777;" />
                            <!--  Refresh icon  -->
                            <TextBlock Text="{ex:Localize Key=RestoreStopwatch}" />
                        </StackPanel>
                    </Button>

                    <Button HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72D;" />
                            <!--  Save icon  -->
                            <TextBlock Text="{ex:Localize Key=Export}" />
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Command="{x:Bind ViewModel.ExportToJsonCommand}" Text="JSON" />
                                <MenuFlyoutItem Command="{x:Bind ViewModel.ExportToCsvCommand}" Text="CSV" />
                                <MenuFlyoutItem Command="{x:Bind ViewModel.ExportToXmlCommand}" Text="XML" />
                                <MenuFlyoutItem Command="{x:Bind ViewModel.ExportToExcelCommand}" Text="Excel" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>

</local:HistoryDetailViewBase>
