<UserControl
    x:Class="Stopwatch.Controls.StopwatchDisplayControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:android="http://uno.ui/android"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ex="using:Stopwatch.Extensions.Xaml"
    xmlns:lapVM="using:Stopwatch.ViewModels"
    xmlns:local="using:Stopwatch.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:not_android="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:win="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    d:DesignHeight="300"
    d:DesignWidth="400"
    mc:Ignorable="d android">

    <Grid RowSpacing="16">
        <Grid.Resources>
            <SolidColorBrush
                x:Name="SubtleForegroundBrush"
                Opacity="0.8"
                Color="{ThemeResource TextFillColorPrimary}" />
            <!--  Wide layout DataTemplate  -->
            <DataTemplate x:Key="WideItemTemplate" x:DataType="lapVM:LapViewModel">
                <Grid
                    Padding="8"
                    Background="Transparent"
                    ColumnSpacing="16">
                    <Grid.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem
                                Command="{x:Bind RequestDeleteCommand}"
                                Icon="Delete"
                                Text="Delete" />
                        </MenuFlyout>
                    </Grid.ContextFlyout>
                    <Grid.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                        <Style BasedOn="{StaticResource DefaultTextBoxStyle}" TargetType="TextBox">
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0,0,0,2" />
                        </Style>
                        <Style x:Key="LapHighlightFontIconStyle" TargetType="FontIcon">
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </Style>
                    </Grid.Resources>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.8*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontWeight="Bold"
                            Text="{x:Bind Order}" />
                        <FontIcon
                            Grid.Column="1"
                            Glyph="&#xEDD7;"
                            Style="{StaticResource LapHighlightFontIconStyle}"
                            Visibility="{x:Bind IsFastest, Mode=OneWay}" />
                        <FontIcon
                            Grid.Column="1"
                            Glyph="&#xEDD8;"
                            Style="{StaticResource LapHighlightFontIconStyle}"
                            Visibility="{x:Bind IsSlowest, Mode=OneWay}" />
                    </Grid>
                    <TextBlock Grid.Column="1" Text="{x:Bind TimeString}" />
                    <TextBlock Grid.Column="2" Text="{x:Bind TotalTimeString}" />
                    <TextBox Grid.Column="3" Text="{x:Bind Note, Mode=TwoWay}" />
                </Grid>
            </DataTemplate>

            <!--  Narrow layout DataTemplate  -->
            <DataTemplate x:Key="NarrowItemTemplate" x:DataType="lapVM:LapViewModel">
                <Grid
                    Padding="8"
                    Background="Transparent"
                    RowSpacing="4">
                    <Grid.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem
                                Command="{x:Bind RequestDeleteCommand}"
                                Icon="Delete"
                                Text="Delete" />
                        </MenuFlyout>
                    </Grid.ContextFlyout>
                    <Grid.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                        <Style BasedOn="{StaticResource DefaultTextBoxStyle}" TargetType="TextBox">
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0,0,0,2" />
                        </Style>
                        <Style x:Key="LapHighlightFontIconStyle" TargetType="FontIcon">
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </Style>
                    </Grid.Resources>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  First row: Lap number and LapTime  -->
                    <Grid
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="0,0,16,0"
                        ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontWeight="Bold"
                            Text="{x:Bind Order}" />
                        <FontIcon
                            Grid.Column="1"
                            Glyph="&#xEDD7;"
                            Style="{StaticResource LapHighlightFontIconStyle}"
                            Visibility="{x:Bind IsFastest, Mode=OneWay}" />
                        <FontIcon
                            Grid.Column="1"
                            Glyph="&#xEDD8;"
                            Style="{StaticResource LapHighlightFontIconStyle}"
                            Visibility="{x:Bind IsSlowest, Mode=OneWay}" />
                    </Grid>
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="1"
                        Text="{x:Bind TimeString}" />

                    <!--  Second row: TotalTime and Note  -->
                    <TextBox
                        Grid.Row="1"
                        Grid.Column="0"
                        Text="{x:Bind Note, Mode=TwoWay}" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,0,16,0"
                        Opacity="0.7"
                        Text="{x:Bind TotalTimeString}" />
                </Grid>
            </DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Viewbox Grid.Row="0" Stretch="Uniform">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <!--<FontIcon Glyph="{x:Bind Stopwatch.Icon, Mode=OneWay}" />-->
                    <TextBox
                        x:Name="StopwatchNameTextBox"
                        Padding="4"
                        HorizontalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0,0,0,0"
                        FontSize="40"
                        Text="{x:Bind Stopwatch.Name, Mode=TwoWay}" />
                </StackPanel>
                <Grid
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <not_android:TextBlock win:FontFamily="Segoe UI">
                        <Run FontSize="120" Text="{x:Bind Stopwatch.CurrentTime, Mode=OneWay}" />
                        <Run
                            FontSize="80"
                            Foreground="{ThemeResource SubtleForegroundBrush}"
                            Text="." />
                        <Run
                            FontSize="80"
                            Foreground="{ThemeResource SubtleForegroundBrush}"
                            Text="{x:Bind Stopwatch.CurrentTimeMilliseconds, Mode=OneWay}" />
                    </not_android:TextBlock>
                    <!--  Workaround for https://github.com/unoplatform/uno/issues/17282  -->
                    <android:TextBlock FontSize="120">
                        <Run Text="{x:Bind Stopwatch.CurrentTimeFull, Mode=OneWay}" />
                    </android:TextBlock>
                </Grid>
                <StackPanel
                    Grid.Row="2"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button Command="{x:Bind Stopwatch.ResetCommand, Mode=OneWay}" Style="{StaticResource ControlButtonStyle}">
                        <SymbolIcon Symbol="Undo" />
                    </Button>
                    <Button
                        x:Name="StartStopButton"
                        Command="{x:Bind Stopwatch.StartStopCommand, Mode=OneWay}"
                        Style="{StaticResource LargeAccentControlButtonStyle}">
                        <FontIcon FontSize="32" Glyph="{x:Bind Stopwatch.IsRunning, Mode=OneWay, Converter={StaticResource IsRunningToSymbolConverter}}" />
                    </Button>
                    <Button
                        x:Name="LapButton"
                        Command="{x:Bind Stopwatch.LapCommand, Mode=OneWay}"
                        Style="{StaticResource ControlButtonStyle}">
                        <SymbolIcon Symbol="Flag" />
                    </Button>
                </StackPanel>
            </Grid>
        </Viewbox>
        <Expander
            x:Name="LapsExpander"
            Grid.Row="2"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            HorizontalContentAlignment="Stretch"
            ExpandDirection="Up"
            Header="{ex:Localize Key=Laps}"
            IsExpanded="{x:Bind Stopwatch.IsLapsListExpanded, Mode=TwoWay}">
            <Grid
                x:Name="LapListRoot"
                Grid.Row="2"
                MaxWidth="600"
                HorizontalAlignment="Stretch">
                <Grid.Resources />
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid
                    x:Name="HeaderGrid"
                    Grid.Row="0"
                    Padding="8"
                    BorderBrush="{ThemeResource AccentAAFillColorDefaultBrush}"
                    BorderThickness="0,0,0,1">
                    <Grid.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </Grid.Resources>

                    <!--  Wide layout header  -->
                    <Grid x:Name="HeaderWideLayout" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.8*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{ex:Localize Key=Lap}" />
                        <TextBlock Grid.Column="1" Text="{ex:Localize Key=LapTime}" />
                        <TextBlock Grid.Column="2" Text="{ex:Localize Key=TotalTime}" />
                        <TextBlock Grid.Column="3" Text="{ex:Localize Key=Note}" />
                    </Grid>

                    <!--  Narrow layout header  -->
                    <Grid x:Name="HeaderNarrowLayout" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,16,0"
                            Text="{ex:Localize Key=Lap}" />
                        <TextBlock Grid.Column="1" Text="{ex:Localize Key=LapTime}" />
                    </Grid>
                </Grid>
                <ListView
                    x:Name="LapsListView"
                    Grid.Row="1"
                    HorizontalAlignment="Stretch"
                    ItemTemplate="{StaticResource WideItemTemplate}"
                    ItemsSource="{x:Bind Stopwatch.Laps, Mode=OneWay}"
                    SelectionMode="Single">
                    <ListView.ItemContainerStyle>
                        <!--  Apply BasedOn only on WinUI as the style is not available in Uno Platform https://github.com/unoplatform/uno/issues/17231  -->
                        <Style win:BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
                <StackPanel
                    Grid.Row="2"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button Style="{ThemeResource SubtleButtonStyle}" ToolTipService.ToolTip="Export">
                        <FontIcon Glyph="&#xE72D;" />
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem
                                    Command="{x:Bind MainViewModel.ExportToCsvCommand}"
                                    Icon="Document"
                                    Text="{ex:Localize Key=ExportToCsv}" />
                                <MenuFlyoutItem
                                    Command="{x:Bind MainViewModel.ExportToJsonCommand}"
                                    Icon="Page"
                                    Text="{ex:Localize Key=ExportToJson}" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </Expander>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="500" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeaderWideLayout.Visibility" Value="Visible" />
                        <Setter Target="HeaderNarrowLayout.Visibility" Value="Collapsed" />
                        <Setter Target="LapsListView.ItemTemplate" Value="{StaticResource WideItemTemplate}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeaderWideLayout.Visibility" Value="Collapsed" />
                        <Setter Target="HeaderNarrowLayout.Visibility" Value="Visible" />
                        <Setter Target="LapsListView.ItemTemplate" Value="{StaticResource NarrowItemTemplate}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</UserControl>
