<local:MainViewBase
    x:Class="Stopwatch.Views.MainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    xmlns:controls="using:Stopwatch.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ex="using:Stopwatch.Extensions.Xaml"
    xmlns:local="using:Stopwatch.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Stopwatch.ViewModels"
    xmlns:wctc="using:CommunityToolkit.WinUI.Converters">

    <local:MainViewBase.Resources>
        <TeachingTip
            x:Key="OnboardingTeachingTip"
            ActionButtonClick="OnTeachingTipClick"
            CloseButtonClick="OnTeachingTipClick">
            <TeachingTip.ActionButtonContent>
                <TextBlock Text="{ex:Localize Key=GotIt}" />
            </TeachingTip.ActionButtonContent>
        </TeachingTip>
    </local:MainViewBase.Resources>

    <Grid x:Name="RootGrid">
        <Grid PointerMoved="RootGridPointerEvent" PointerPressed="RootGridPointerEvent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Title bar area  -->
            <Grid x:Name="TitleBarArea" Height="48" Visibility="{x:Bind ViewModel.IsCompactOverlay, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}">

                <Border
                    Height="1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Bottom"
                    Background="{ThemeResource TabViewBorderBrush}"
                    Opacity="0.8" />

                <Border
                    x:Name="TabViewContainer"
                    Padding="36,0"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    Visibility="Collapsed">
                    <TabView
                        x:Name="StopwatchTabView"
                        Padding="0,8,0,0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Bottom"
                        AddTabButtonCommand="{x:Bind ViewModel.AddStopwatchCommand}"
                        SelectedItem="{x:Bind ViewModel.SelectedStopwatch, Mode=TwoWay}"
                        TabCloseRequested="TabView_TabCloseRequested"
                        TabItemsSource="{x:Bind ViewModel.Stopwatches}">
                        <TabView.TabItemTemplate>
                            <DataTemplate x:DataType="vm:StopwatchViewModel">
                                <TabViewItem Header="{x:Bind Name, Mode=OneWay}" IsClosable="True" />
                            </DataTemplate>
                        </TabView.TabItemTemplate>
                        <TabView.TabStripFooter>
                            <Border x:Name="FooterArea" HorizontalAlignment="Stretch" />
                        </TabView.TabStripFooter>
                        <TabView.Resources>
                            <SolidColorBrush x:Key="TabViewBorderBrush" Color="Transparent" />
                        </TabView.Resources>
                    </TabView>
                </Border>

                <Border
                    x:Name="TitleBarButtonArea"
                    Height="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Background="{ThemeResource TabViewBorderBrush}" />

                <Border
                    x:Name="DraggableArea"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Stretch"
                    Background="Transparent" />
            </Grid>

            <!--  Compact overlay header  -->
            <Grid
                x:Name="CompactOverlayHeader"
                Grid.Row="0"
                Height="40"
                Padding="4,0"
                Visibility="{x:Bind ViewModel.IsCompactOverlay, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border
                    x:Name="CompactOverlayDraggableArea"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="Transparent" />
                <Button
                    Command="{x:Bind ViewModel.ToggleCompactOverlayCommand}"
                    Style="{ThemeResource SubtleButtonStyle}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="{ex:Localize Key=CompactOverlay}">
                    <FontIcon FontSize="14" Glyph="&#xEE47;" />
                </Button>
            </Grid>

            <!--  Background color  -->
            <Border Grid.Row="2">
                <Border.Background>
                    <SolidColorBrush Color="{x:Bind ViewModel.SelectedStopwatch.BackgroundColor, Mode=OneWay}" />
                </Border.Background>
            </Border>

            <!--  Background image  -->
            <Border Grid.Row="2" Visibility="{x:Bind ViewModel.SelectedStopwatch.BackgroundImageUri, Converter={StaticResource NonNullToVisibilityConverter}, FallbackValue=Collapsed, Mode=OneWay}">
                <Image
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Opacity="{x:Bind ViewModel.SelectedStopwatch.BackgroundImageOpacity, Mode=OneWay}"
                    Stretch="UniformToFill">
                    <Image.Source>
                        <BitmapImage UriSource="{x:Bind ViewModel.SelectedStopwatch.BackgroundImageUri, Mode=OneWay}" />
                    </Image.Source>
                </Image>
            </Border>

            <!--  Content  -->
            <Grid
                x:Name="ContentRoot"
                Grid.Row="2"
                Padding="12,12,12,12"
                RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel
                    x:Name="ControlButtonsPanel"
                    Grid.Row="1"
                    Margin="0,0,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.IsCompactOverlay, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}">
                    <Button
                        Command="{x:Bind ViewModel.ToggleFullScreenCommand}"
                        Style="{ThemeResource SubtleButtonStyle}"
                        ToolTipService.ToolTip="{ex:Localize Key=FullScreen}"
                        Visibility="{x:Bind ViewModel.ShowFullScreenButton, Mode=OneWay}">
                        <FontIcon Glyph="{x:Bind ViewModel.IsFullScreen, Mode=OneWay, Converter={StaticResource IsFullScreenToSymbolConverter}}" />
                    </Button>
                    <Button
                        Command="{x:Bind ViewModel.ToggleCompactOverlayCommand}"
                        Style="{ThemeResource SubtleButtonStyle}"
                        ToolTipService.ToolTip="{ex:Localize Key=CompactOverlay}"
                        Visibility="{x:Bind ViewModel.ShowCompactOverlayButton, Mode=OneWay}">
                        <FontIcon Glyph="{x:Bind ViewModel.IsCompactOverlay, Mode=OneWay, Converter={StaticResource IsCompactOverlayToSymbolConverter}}" />
                    </Button>
                    <!--<Button Command="{x:Bind ViewModel.GoToHistoryCommand}" Style="{ThemeResource SubtleButtonStyle}">
						<FontIcon Glyph="&#xE81C;" />
					</Button>-->
                    <Button
                        Command="{x:Bind ViewModel.GoToGetProCommand}"
                        Foreground="Gold"
                        Style="{ThemeResource SubtleButtonStyle}"
                        Visibility="{x:Bind ViewModel.HasProLicense, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}">
                        <FontIcon Foreground="Gold" Glyph="&#xF133;" />
                    </Button>
                    <Button
                        x:Name="TabListButton"
                        Style="{ThemeResource SubtleButtonStyle}"
                        ToolTipService.ToolTip="{ex:Localize Key=Stopwatches}">
                        <FontIcon Glyph="&#xE8B7;" />
                        <Button.Flyout>
                            <Flyout>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <ListView
                                        Grid.Row="0"
                                        ItemsSource="{x:Bind ViewModel.Stopwatches}"
                                        SelectedItem="{x:Bind ViewModel.SelectedStopwatch, Mode=TwoWay}"
                                        SelectionMode="Single">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="vm:StopwatchViewModel">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center" Text="{x:Bind Name, Mode=OneWay}" />
                                                    <Button
                                                        Grid.Column="1"
                                                        Click="CloseTabClick"
                                                        CommandParameter="{x:Bind}"
                                                        Style="{ThemeResource SubtleButtonStyle}">
                                                        <FontIcon Glyph="&#xE711;" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <Button
                                        Grid.Row="1"
                                        HorizontalAlignment="Stretch"
                                        Command="{x:Bind ViewModel.AddStopwatchCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <SymbolIcon Symbol="Add" />
                                            <TextBlock Text="{ex:Localize Key=AddStopwatch}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button Command="{x:Bind ViewModel.GoToSettingsCommand}" Style="{ThemeResource SubtleButtonStyle}">
                        <AnimatedIcon Width="20">
                            <AnimatedIcon.Source>
                                <animatedvisuals:AnimatedSettingsVisualSource />
                            </AnimatedIcon.Source>
                            <AnimatedIcon.FallbackIconSource>
                                <SymbolIconSource Symbol="Setting" />
                            </AnimatedIcon.FallbackIconSource>
                        </AnimatedIcon>
                    </Button>
                </StackPanel>

                <controls:StopwatchDisplayControl
                    Grid.Row="2"
                    IsCompactOverlay="{x:Bind ViewModel.IsCompactOverlay, Mode=OneWay}"
                    MainViewModel="{x:Bind ViewModel}"
                    Stopwatch="{x:Bind ViewModel.SelectedStopwatch, Mode=OneWay}" />
            </Grid>
        </Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ContentRoot.Padding" Value="12,12,12,12" />
                        <Setter Target="TabViewContainer.Visibility" Value="Collapsed" />
                        <Setter Target="TabListButton.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Medium">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="500" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ContentRoot.Padding" Value="12,12,12,12" />
                        <Setter Target="TabViewContainer.Visibility" Value="Visible" />
                        <Setter Target="TabListButton.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="640" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ContentRoot.Padding" Value="24,24,24,24" />
                        <Setter Target="TabViewContainer.Visibility" Value="Visible" />
                        <Setter Target="TabListButton.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</local:MainViewBase>
