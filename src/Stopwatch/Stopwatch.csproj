<Project Sdk="Uno.Sdk">
	<PropertyGroup>
		<TargetFrameworks>
			net10.0-windows10.0.26100;
			net10.0-android;
			net10.0-ios;
			net10.0-desktop;
			net10.0-browserwasm;
		</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<UnoSingleProject>true</UnoSingleProject>

		<!-- Display name -->
		<ApplicationTitle>Fluent Stopwatch</ApplicationTitle>
		<!-- App Identifier -->
		<ApplicationId>dev.mzikmund.stopwatch</ApplicationId>
		<!-- Versions -->
		<ApplicationDisplayVersion>0.10.2</ApplicationDisplayVersion>
		<ApplicationVersion>31</ApplicationVersion>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>

		<UnoFeatures>
			Configuration;
			Hosting;
			Mvvm;
			Localization;
			ThemeService;
		</UnoFeatures>

		<UnoIconBackgroundFile>Assets/Icons/icon_transparent.svg</UnoIconBackgroundFile>
		<UnoIconBackgroundFile Condition="'$(IsIOS)' == 'true' or '$(IsAndroid)' == 'true'">Assets/Icons/icon.svg</UnoIconBackgroundFile>

		<UnoIconForegroundScale>1</UnoIconForegroundScale>
		<UnoIconForegroundScale Condition="'$(IsAndroid)' == 'true'">0.65</UnoIconForegroundScale>

	</PropertyGroup>

	<PropertyGroup Condition="'$(TargetFramework)'=='net10.0-browserwasm'">
		<WasmShellEnableIDBFS>true</WasmShellEnableIDBFS>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="LiteDB" Condition="'$(IsIOS)' != 'true' and '$(IsAndroid)' != 'true'" />
		<PackageReference Include="MZikmund.Toolkit.WinUI" />
		<PackageReference Include="MZikmund.Uno.RevenueCat" Condition="'$(IsIOS)' == 'true' or '$(IsAndroid)' == 'true'" />
	</ItemGroup>

	<ItemGroup Condition="'$(IsIOS)' == 'true' or '$(IsAndroid)' == 'true'">
		<PackageReference Include="sqlite-net-e" />
		<PackageReference Include="SourceGear.sqlite3" />
	</ItemGroup>

	<ItemGroup Condition="'$(IsAndroid)' == 'true'">
		<PackageReference Include="Xamarin.AndroidX.Collection.Ktx" />
		<PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Core.Ktx" />
	</ItemGroup>

	<ItemGroup Condition="'$(IsIOS)' == 'true'">
		<BundleResource Include="Platforms\iOS\Resources\**" TargetPath="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="../Stopwatch.SourceGenerators/Stopwatch.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>

	<ItemGroup>
		<AdditionalFiles Include="../Directory.Packages.props" />
	</ItemGroup>
</Project>
