<local:MainViewBase
    x:Class="Stopwatch.Views.MainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    xmlns:controls="using:Stopwatch.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ex="using:Stopwatch.Extensions.Xaml"
    xmlns:local="using:Stopwatch.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Stopwatch.ViewModels"
    xmlns:wctc="using:CommunityToolkit.WinUI.Converters">

    <Grid>
        <Grid PointerMoved="RootGridPointerEvent" PointerPressed="RootGridPointerEvent">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="WindowStates">
                    <VisualState x:Name="WideState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="720" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="MainContentGrid.Padding" Value="{StaticResource WideContentMarginLarge}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="NarrowState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="MainContentGrid.Padding" Value="{StaticResource NarrowContentMarginLarge}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Title bar area  -->
            <Grid Height="40">

                <Border
                    Height="1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Bottom"
                    Background="{ThemeResource TabViewBorderBrush}"
                    Opacity="0.8" />

                <Border
                    x:Name="TabViewContainer"
                    Padding="36,0"
                    HorizontalAlignment="Left"
                    Background="Transparent">
                    <TabView
                        x:Name="StopwatchTabView"
                        Padding="0,8,0,0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Bottom"
                        AddTabButtonCommand="{x:Bind ViewModel.AddStopwatchCommand}"
                        SelectedItem="{x:Bind ViewModel.SelectedStopwatch, Mode=TwoWay}"
                        TabCloseRequested="TabView_TabCloseRequested"
                        TabItemsSource="{x:Bind ViewModel.Stopwatches}">
                        <TabView.TabItemTemplate>
                            <DataTemplate x:DataType="vm:StopwatchViewModel">
                                <TabViewItem Header="{x:Bind Name, Mode=OneWay}" IsClosable="True" />
                            </DataTemplate>
                        </TabView.TabItemTemplate>
                        <TabView.TabStripFooter>
                            <Border x:Name="FooterArea" HorizontalAlignment="Stretch" />
                        </TabView.TabStripFooter>
                        <TabView.Resources>
                            <SolidColorBrush x:Key="TabViewBorderBrush" Color="Transparent" />
                        </TabView.Resources>
                    </TabView>
                </Border>

                <Border
                    x:Name="TitleBarButtonArea"
                    Height="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Background="{ThemeResource TabViewBorderBrush}" />

                <Border
                    x:Name="DraggableArea"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Stretch"
                    Background="Transparent" />
            </Grid>

            <!--  Background color  -->
            <Border Grid.Row="1">
                <Border.Background>
                    <SolidColorBrush Color="{x:Bind ViewModel.SelectedStopwatch.BackgroundColor, Mode=OneWay}" />
                </Border.Background>
            </Border>

            <!--  Background image  -->
            <Border Grid.Row="1" Visibility="{x:Bind ViewModel.SelectedStopwatch.BackgroundImageUri, Converter={StaticResource NonNullToVisibilityConverter}, FallbackValue=Collapsed, Mode=OneWay}">
                <Image
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Opacity="{x:Bind ViewModel.SelectedStopwatch.BackgroundImageOpacity, Mode=OneWay}"
                    Stretch="UniformToFill">
                    <Image.Source>
                        <BitmapImage UriSource="{x:Bind ViewModel.SelectedStopwatch.BackgroundImageUri, Mode=OneWay}" />
                    </Image.Source>
                </Image>
            </Border>

            <!--  Content  -->
            <Grid
                x:Name="MainContentGrid"
                Grid.Row="1"
                Padding="{StaticResource WideContentMarginLarge}"
                RowSpacing="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel
                    x:Name="ControlButtonsPanel"
                    Grid.Row="1"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        Command="{x:Bind ViewModel.ToggleFullScreenCommand}"
                        Style="{ThemeResource SubtleButtonStyle}"
                        ToolTipService.ToolTip="{ex:Localize Key=FullScreen}"
                        Visibility="{x:Bind ViewModel.ShowFullScreenButton, Mode=OneWay}">
                        <FontIcon Glyph="{x:Bind ViewModel.IsFullScreen, Mode=OneWay, Converter={StaticResource IsFullScreenToSymbolConverter}}" />
                    </Button>
                    <!--<Button
                    Command="{x:Bind ViewModel.ToggleCompactOverlayCommand}"
                    Style="{ThemeResource SubtleButtonStyle}"
                    Visibility="{x:Bind ViewModel.ShowCompactOverlayButton, Mode=OneWay}">
					<Grid>
						<FontIcon Glyph="{x:Bind ViewModel.IsCompactOverlay, Mode=OneWay, Converter={StaticResource IsCompactOverlayToSymbolConverter}}" />
					</Grid>
					</Button>-->
                    <!--<Button Command="{x:Bind ViewModel.GoToHistoryCommand}" Style="{ThemeResource SubtleButtonStyle}">
						<FontIcon Glyph="&#xE81C;" />
					</Button>-->
                    <Button
                        Command="{x:Bind ViewModel.GoToGetProCommand}"
                        Foreground="Gold"
                        Style="{ThemeResource SubtleButtonStyle}"
                        Visibility="{x:Bind ViewModel.HasProLicense, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}">
                        <FontIcon Foreground="Gold" Glyph="&#xF133;" />
                    </Button>
                    <Button Command="{x:Bind ViewModel.GoToSettingsCommand}" Style="{ThemeResource SubtleButtonStyle}">
                        <AnimatedIcon Width="20">
                            <AnimatedIcon.Source>
                                <animatedvisuals:AnimatedSettingsVisualSource />
                            </AnimatedIcon.Source>
                            <AnimatedIcon.FallbackIconSource>
                                <SymbolIconSource Symbol="Setting" />
                            </AnimatedIcon.FallbackIconSource>
                        </AnimatedIcon>
                    </Button>
                </StackPanel>

                <controls:StopwatchDisplayControl Grid.Row="2" Stopwatch="{x:Bind ViewModel.SelectedStopwatch, Mode=OneWay}" />
            </Grid>
        </Grid>
    </Grid>
</local:MainViewBase>
