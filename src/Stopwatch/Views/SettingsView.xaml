<local:SettingsViewBase
    x:Class="Stopwatch.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ex="using:Stopwatch.Extensions.Xaml"
    xmlns:local="using:Stopwatch.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    mc:Ignorable="d">

	<local:SettingsViewBase.Resources>
		<Style x:Key="SettingsSectionHeaderTextBlockStyle"
               BasedOn="{StaticResource BodyStrongTextBlockStyle}"
               TargetType="TextBlock">
			<Style.Setters>
				<Setter Property="Margin" Value="1,30,0,6" />
			</Style.Setters>
		</Style>
	</local:SettingsViewBase.Resources>

	<Grid Padding="20" RowSpacing="8">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>
		<Grid ColumnSpacing="8">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>
			<Button Command="{x:Bind ViewModel.GoBackCommand}" Style="{ThemeResource NavigationBackButtonStyle}" />
			<TextBlock
                Grid.Column="1"
                Style="{ThemeResource TitleTextBlockStyle}"
                Text="{ex:Localize Key=Settings}" />
		</Grid>
		<ScrollViewer Grid.Row="1">
			<StackPanel Orientation="Vertical" Spacing="8">
				<toolkit:SettingsCard Header="{ex:Localize Key=Theme}" HeaderIcon="{ui:FontIcon Glyph=&#xE793;}">
					<ComboBox
                        ItemsSource="{x:Bind ViewModel.ThemeOptions}"
                        SelectedItem="{x:Bind ViewModel.SelectedTheme, Mode=TwoWay}"
                        Style="{StaticResource DefaultComboBoxStyle}">
						<ComboBox.ItemTemplate>
							<DataTemplate x:DataType="ElementTheme">
								<TextBlock Text="{x:Bind Converter={StaticResource EnumLocalizationConverter}}" />
							</DataTemplate>
						</ComboBox.ItemTemplate>
					</ComboBox>
				</toolkit:SettingsCard>

				<TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="{ex:Localize Key=Customization}" />

				<toolkit:SettingsCard Header="{ex:Localize Key=BackgroundImage}" HeaderIcon="{ui:FontIcon Glyph=&#xE91B;}">
					<SplitButton>
						<Border
                        x:Name="CurrentColor"
                        Width="32"
                        Height="32"
                        CornerRadius="4,0,0,4">
							<Border.Background>
								<SolidColorBrush Color="{x:Bind ViewModel.BackgroundColor, Mode=OneWay}" />
							</Border.Background>
						</Border>
						<SplitButton.Flyout>
							<Flyout Placement="Bottom">
								<ColorPicker
                                IsAlphaEnabled="True"
                                IsAlphaSliderVisible="True"
                                Color="{x:Bind ViewModel.BackgroundColor, Mode=TwoWay}" />
							</Flyout>
						</SplitButton.Flyout>
					</SplitButton>
				</toolkit:SettingsCard>

				<toolkit:SettingsCard Header="{ex:Localize Key=BackgroundColor}" HeaderIcon="{ui:FontIcon Glyph=&#xE708;}">
					<SplitButton>
						<Border
                            Width="32"
                            Height="32"
                            CornerRadius="4,0,0,4">
							<Border.Background>
								<SolidColorBrush Color="{x:Bind ViewModel.BackgroundColor, Mode=OneWay}" />
							</Border.Background>
						</Border>
						<SplitButton.Flyout>
							<Flyout Placement="Bottom">
								<ColorPicker
                                    IsAlphaEnabled="True"
                                    IsAlphaSliderVisible="True"
                                    Color="{x:Bind ViewModel.BackgroundColor, Mode=TwoWay}" />
							</Flyout>
						</SplitButton.Flyout>
					</SplitButton>
				</toolkit:SettingsCard>
				<!--<toolkit:SettingsCard
                    Header="{ex:Localize Key=BackgroundColor}"
                    HeaderIcon="{ui:FontIcon Glyph=&#xE708;}">
					<StackPanel Orientation="Horizontal">
						<Button Content="{ex:Localize Key=BrowseImage}" Command="{x:Bind ViewModel.BrowseImageCommand}" />
						<Button Visibility="{x:Bind ViewModel.BackroundImage, Mode=OneWay, Converter={StaticResource }}" Content="{ex:Localize Key=BrowseImage}" Command="{x:Bind ViewModel.ClaerImageCommand}" />
					</StackPanel>
				</toolkit:SettingsCard>-->

				<TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="{ex:Localize Key=Preview}" />
				<Grid>
					<Border HorizontalAlignment="Stretch" Background="{ThemeResource SystemControlBackgroundAccentBrush}" />
					<Image
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Stretch="UniformToFill">
						<Image.Source>
							<BitmapImage UriSource="{x:Bind ViewModel.BackgroundImageUri, Mode=OneWay}" />
						</Image.Source>
					</Image>
					<TextBlock
                        Margin="10"
                        VerticalAlignment="Bottom"
                        Foreground="#FFF"
                        Opacity="0.8"
                        Text="{ex:Localize Key=Preview}" />
				</Grid>
			</StackPanel>
		</ScrollViewer>
	</Grid>
</local:SettingsViewBase>
