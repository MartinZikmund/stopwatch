<Project ToolsVersion="15.0">
  <ItemGroup>
    <!-- CommunityToolkit.WinUI is a source copy until it targets Uno 7: src/Stopwatch/ThirdParty/CommunityToolkit/README.md -->
    <PackageVersion Include="LiteDB" Version="5.0.21" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="4.14.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.103" />
    <PackageVersion Include="MZikmund.Toolkit.WinUI" Version="1.0.0-dev.71" />
    <PackageVersion Include="MZikmund.Uno.RevenueCat" Version="0.3.0-beta.4" />
    <PackageVersion Include="sqlite-net-e" Version="1.11.0" />
    <PackageVersion Include="SourceGear.sqlite3" Version="3.50.4.5" />
    <!-- Uno 7 brings the AndroidX 1.9/2.11 lines, RevenueCat's binding the older -ktx ones, whose classes then clash in D8 -->
    <PackageVersion Include="Xamarin.AndroidX.Collection.Ktx" Version="1.6.0.1" />
    <PackageVersion Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.9.0" />
    <PackageVersion Include="Xamarin.AndroidX.Lifecycle.LiveData.Core.Ktx" Version="2.11.0.1" />
    <PackageVersion Include="Nerdbank.GitVersioning" Version="3.9.50" />
  </ItemGroup>
</Project>
