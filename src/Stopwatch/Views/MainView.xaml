<local:MainViewBase
    x:Class="Stopwatch.Views.MainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Stopwatch.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ex="using:Stopwatch.Extensions.Xaml"
    xmlns:local="using:Stopwatch.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wctc="using:CommunityToolkit.WinUI.Converters">

    <Grid>

        <!--  Background color  -->
        <Border>
            <Border.Background>
                <SolidColorBrush Color="{x:Bind ViewModel.Stopwatch.BackgroundColor, Mode=OneWay}" />
            </Border.Background>
        </Border>

        <!--  Background image  -->
        <Border Visibility="{x:Bind ViewModel.Stopwatch.BackgroundImageUri, Converter={StaticResource NonNullToVisibilityConverter}, FallbackValue=Collapsed, Mode=OneWay}">
            <Image
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Opacity="{x:Bind ViewModel.Stopwatch.BackgroundImageOpacity, Mode=OneWay}"
                Stretch="UniformToFill">
                <Image.Source>
                    <BitmapImage UriSource="{x:Bind ViewModel.Stopwatch.BackgroundImageUri, Mode=OneWay}" />
                </Image.Source>
            </Image>
        </Border>

        <Grid
            Padding="36,60,36,36"
            Background="Transparent"
            PointerMoved="RootGridPointerEvent"
            PointerPressed="RootGridPointerEvent"
            RowSpacing="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="1.5*" />
            </Grid.RowDefinitions>

            <StackPanel
                x:Name="ControlButtonsPanel"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    Command="{x:Bind ViewModel.ToggleFullScreenCommand}"
                    Style="{ThemeResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="{ex:Localize Key=FullScreen}"
                    Visibility="{x:Bind ViewModel.ShowFullScreenButton, Mode=OneWay}">
                    <FontIcon Glyph="{x:Bind ViewModel.IsFullScreen, Mode=OneWay, Converter={StaticResource IsFullScreenToSymbolConverter}}" />
                </Button>
                <!--<Button
                    Command="{x:Bind ViewModel.ToggleCompactOverlayCommand}"
                    Style="{ThemeResource SubtleButtonStyle}"
                    Visibility="{x:Bind ViewModel.ShowCompactOverlayButton, Mode=OneWay}">
					<Grid>
						<FontIcon Glyph="{x:Bind ViewModel.IsCompactOverlay, Mode=OneWay, Converter={StaticResource IsCompactOverlayToSymbolConverter}}" />
					</Grid>
				</Button>-->
                <Button Command="{x:Bind ViewModel.GoToSettingsCommand}" Style="{ThemeResource SubtleButtonStyle}">
                    <Grid>
                        <SymbolIcon Symbol="Setting" />
                    </Grid>
                </Button>
            </StackPanel>

            <controls:StopwatchDisplayControl Stopwatch="{x:Bind ViewModel.CurrentStopwatch, Mode=OneWay}" />

            <TextBlock
                Margin="8"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="Beta" />
        </Grid>
    </Grid>
</local:MainViewBase>
