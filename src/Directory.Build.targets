<Project>
	<!-- Automated versioning properties -->
	<PropertyGroup>
		<!-- Use GitVersioning for ApplicationDisplayVersion and ApplicationVersion -->
		<!-- NBGV provides BuildVersion, BuildVersionSimple, and other properties -->
		<ApplicationDisplayVersion Condition="'$(BuildVersionSimple)' != ''">$(BuildVersionSimple)</ApplicationDisplayVersion>
		<ApplicationDisplayVersion Condition="'$(BuildVersionSimple)' == ''">0.9.0</ApplicationDisplayVersion>
		<ApplicationVersion Condition="'$(VersionHeight)' != ''">$(VersionHeight)</ApplicationVersion>
		<ApplicationVersion Condition="'$(VersionHeight)' == ''">1</ApplicationVersion>
	</PropertyGroup>

	<!-- Windows package manifest versioning -->
	<PropertyGroup Condition="'$(TargetFramework)' == 'net9.0-windows10.0.26100'">
		<!-- Use NBGV BuildVersion for Windows manifest versioning -->
		<UnoManifestVersion Condition="'$(BuildVersion)' != ''">$(BuildVersion)</UnoManifestVersion>
		<UnoManifestVersion Condition="'$(UnoManifestVersion)' == ''">0.9.0.1</UnoManifestVersion>
	</PropertyGroup>

	<!-- Target to update Package.appxmanifest with computed version -->
	<Target Name="UpdatePackageManifestVersion" BeforeTargets="GenerateAppxManifest" Condition="'$(TargetFramework)' == 'net9.0-windows10.0.26100' AND '$(UnoManifestVersion)' != '0.9.0.0'">
		<PropertyGroup>
			<ManifestPath>$(MSBuildProjectDirectory)/Package.appxmanifest</ManifestPath>
			<BackupManifestPath>$(MSBuildProjectDirectory)/Package.appxmanifest.backup</BackupManifestPath>
		</PropertyGroup>
		
		<!-- Create backup of original manifest -->
		<Copy SourceFiles="$(ManifestPath)" DestinationFiles="$(BackupManifestPath)" Condition="!Exists('$(BackupManifestPath)')" />
		
		<!-- Read, update and write back the manifest -->
		<ItemGroup>
			<ManifestLines Include="$([System.IO.File]::ReadAllLines('$(ManifestPath)'))" />
		</ItemGroup>
		
		<PropertyGroup>
			<UpdatedManifestContent>@(ManifestLines->Replace('Version="0.9.0.0"', 'Version="$(UnoManifestVersion)"'), '%0D%0A')</UpdatedManifestContent>
		</PropertyGroup>
		
		<WriteLinesToFile File="$(ManifestPath)" Lines="$(UpdatedManifestContent)" Overwrite="true" />
		
		<Message Text="Updated Package.appxmanifest version to $(UnoManifestVersion)" Importance="high" />
	</Target>

	<!-- Target to restore original manifest after build -->
	<Target Name="RestorePackageManifestVersion" AfterTargets="Build" Condition="'$(TargetFramework)' == 'net9.0-windows10.0.26100' AND Exists('$(MSBuildProjectDirectory)/Package.appxmanifest.backup')">
		<Copy SourceFiles="$(MSBuildProjectDirectory)/Package.appxmanifest.backup" DestinationFiles="$(MSBuildProjectDirectory)/Package.appxmanifest" />
		<Delete Files="$(MSBuildProjectDirectory)/Package.appxmanifest.backup" />
	</Target>

	<!-- Target to display version information -->
	<Target Name="ShowVersionInfo" AfterTargets="Build">
		<Message Text="=== VERSION INFORMATION ===" Importance="high" />
		<Message Text="BuildVersion: $(BuildVersion)" Importance="high" />
		<Message Text="BuildVersionSimple: $(BuildVersionSimple)" Importance="high" />
		<Message Text="VersionHeight: $(VersionHeight)" Importance="high" />
		<Message Text="ApplicationDisplayVersion: $(ApplicationDisplayVersion)" Importance="high" />
		<Message Text="ApplicationVersion: $(ApplicationVersion)" Importance="high" />
		<Message Text="Version: $(Version)" Importance="high" />
		<Message Text="AssemblyVersion: $(AssemblyVersion)" Importance="high" />
		<Message Text="FileVersion: $(FileVersion)" Importance="high" />
		<Message Text="==============================" Importance="high" />
	</Target>
</Project>
