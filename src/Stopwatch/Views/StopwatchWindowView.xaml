<local:StopwatchWindowViewBase
    x:Class="Stopwatch.Views.StopwatchWindowView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Stopwatch.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Stopwatch.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Stopwatch.ViewModels"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Visibility="{x:Bind ViewModel.Stopwatch, Converter={StaticResource NonNullToVisibilityConverter}, Mode=OneWay}">
        <!--  Background color  -->
        <Border>
            <Border.Background>
                <SolidColorBrush Color="{x:Bind ViewModel.Stopwatch.BackgroundColor, Mode=OneWay}" />
            </Border.Background>
        </Border>

        <!--  Background image  -->
        <Border Visibility="{x:Bind ViewModel.Stopwatch.BackgroundImageUri, Converter={StaticResource NonNullToVisibilityConverter}, FallbackValue=Collapsed, Mode=OneWay}">
            <Image
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Opacity="{x:Bind ViewModel.Stopwatch.BackgroundImageOpacity, Mode=OneWay}"
                Stretch="UniformToFill">
                <Image.Source>
                    <BitmapImage UriSource="{x:Bind ViewModel.Stopwatch.BackgroundImageUri, Mode=OneWay}" />
                </Image.Source>
            </Image>
        </Border>

        <!--  Stopwatch Content  -->
        <Grid Padding="24">
            <controls:StopwatchDisplayControl Stopwatch="{x:Bind ViewModel.Stopwatch, Mode=OneWay}" />
        </Grid>
    </Grid>
</local:StopwatchWindowViewBase>